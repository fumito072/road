generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  displayName    String?
  role           UserRole @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  uploads Upload[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Tab {
  id                     String   @id @default(cuid())
  name                   String
  order                  Int      @default(0)
  isDefault              Boolean  @default(false)
  isActive               Boolean  @default(true)
  icon                   String?
  ocrPromptTemplate      String?  @db.Text
  workflowPromptTemplate String?  @db.Text
  sharepointSiteId       String?
  sharepointDriveId      String?
  sharepointFolderPath   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  uploads       Upload[]
  namingRules   NamingRule[]
  vendorAliases VendorAlias[]

  @@map("tabs")
}

/// OCR が読み取った取引先名と、ユーザーが保存時に確定した表記の対応表。
/// 「毎回同じ修正をさせない」ための学習データで、タブ単位で全ユーザーが共有する。
model VendorAlias {
  id           String   @id @default(cuid())
  tabId        String
  /// OCR の読み取り値を正規化したキー（NFKC・会社種別除去・空白除去・小文字化）。
  matchKey     String
  /// ユーザーが確定した表記。次回以降はこの値を自動で入れる。
  correctedTo  String
  /// 学習の元になった OCR の生の読み取り値（管理・調査用）。
  sourceValue  String
  /// 自動適用された回数。学習効果の可視化に使う。
  hitCount     Int      @default(0)
  /// 最後に更新したユーザーのメール。User への FK は張らない（ユーザー削除を妨げないため）。
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tab Tab @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@unique([tabId, matchKey])
  @@index([tabId])
  @@map("vendor_aliases")
}

model NamingRule {
  id           String   @id @default(cuid())
  tabId        String
  documentType String
  pattern      String
  description  String?  @db.Text
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tab Tab @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@index([tabId])
  @@map("naming_rules")
}

enum UploadStatus {
  PENDING
  OCR_PROCESSING
  OCR_DONE
  CONFIRMED
  UPLOADING_SHAREPOINT
  COMPLETED
  ERROR
}

model Upload {
  id                       String       @id @default(cuid())
  tabId                    String
  userId                   String
  folderName               String
  contractNumber           String?
  customerName             String?
  applicationNumber        String?
  status                   UploadStatus @default(PENDING)
  sharepointDestinationPath String?
  sharepointItemId         String?
  sharepointWebUrl         String?
  ocrRawResponse           Json?
  ocrStructuredResult      Json?
  ocrConfidence            Float?
  needsReview              Boolean      @default(false)
  confirmedAt              DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  tab   Tab          @relation(fields: [tabId], references: [id])
  user  User         @relation(fields: [userId], references: [id])
  files UploadFile[]

  @@index([tabId])
  @@index([userId])
  @@index([status])
  @@map("uploads")
}

model UploadFile {
  id               String   @id @default(cuid())
  uploadId         String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  storagePath      String
  createdAt        DateTime @default(now())

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@map("upload_files")
}
