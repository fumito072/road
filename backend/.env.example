# ============================================================
# LOAD OCR Hub - backend 環境変数テンプレート
# ------------------------------------------------------------
# 使い方:
#   cp backend/.env.example backend/.env
#   そのうえで、別途安全な経路で受領した値を設定してください。
#   （秘密情報はこのファイルには含めません。値はダミーです）
# ============================================================

# --- データベース（必須） ---
# PostgreSQL接続URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/road_dev"

# --- サーバー（推奨） ---
# バックエンドの起動ポート。ローカルでは 3003 を推奨
PORT=3003
# 実行環境: development / production / staging
NODE_ENV=development
# staging の場合、CORSをステージング向けに緩和
# APP_ENV=staging

# --- CORS（本番必須） ---
# CORSで許可するフロントエンドURL。本番では必ず設定すること
FRONTEND_URL="http://localhost:3000"
# ステージング検証用途のみ: 任意Originを反射して許可（本番では使用しない）
# CORS_ALLOW_ALL_ORIGINS="true"

# --- 認証 / JWT（必須） ---
# JWT署名用secret。十分に長いランダム文字列を設定（例: openssl rand -hex 32）
AUTH_JWT_SECRET="replace-with-local-secret"
# JWT有効期限（任意）。例: 24h
AUTH_JWT_EXPIRES_IN="24h"
# ローカル検証専用: Bearer tokenなしで開発用ユーザーを使う（本番では絶対に true にしない）
# AUTH_ALLOW_DEV_USER="true"

# --- Gemini API（OCR利用時必須） ---
GEMINI_API_KEY="replace-with-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.5-flash-lite"
GEMINI_RETRY_ATTEMPTS="3"
# ローカル/デモ用: Geminiを呼ばず決まったモック結果を返す
# OCR_MOCK_MODE="true"

# --- SharePoint / Microsoft Graph API（SharePoint利用時必須） ---
AZURE_TENANT_ID="replace-with-tenant-id"
AZURE_CLIENT_ID="replace-with-client-id"
AZURE_CLIENT_SECRET="replace-with-client-secret"
