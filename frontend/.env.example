# ============================================================
# LOAD OCR Hub - frontend 環境変数テンプレート
# ------------------------------------------------------------
# 使い方:
#   cp frontend/.env.example frontend/.env.local
# ============================================================

# Next.js middleware が /api/* を転送するバックエンドURL
# ローカル: http://localhost:3003
# 本番:     https://<backend-service-domain>
BACKEND_URL=http://localhost:3003

# ブラウザから直接API URLへアクセスさせる場合のみ使用（任意）
# NEXT_PUBLIC_API_URL=
